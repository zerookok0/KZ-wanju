# ┌─ public/_headers ───────────────────────────────────────────────────────
# │ HTTP-заголовки: CSP / кэш / индексация
# │ Если пиксель FB не получает данные — правь Content-Security-Policy ниже
# │ Формат: путь с начала строки, заголовок с отступом 2 пробела
# └───────────────────────────────────────────────────────────────
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  X-DNS-Prefetch-Control: off
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://analytics.tiktok.com https://static.ads-twitter.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://graph.facebook.com https://analytics.tiktok.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Короткий кэш конфига, чтобы правки применялись сразу
/config.js
  Cache-Control: public, max-age=300, must-revalidate

# Скриншоты не индексируем
/preview/*
  X-Robots-Tag: noindex, nofollow
